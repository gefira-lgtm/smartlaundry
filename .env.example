# ============================================================
# SMARTLAUNDRY PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Anda
# ============================================================

# Application
APP_NAME="SmartLaundry Pro"
APP_ENV=local # 'local' untuk development, 'production' untuk live server
APP_DEBUG=true
APP_URL=http://localhost/RPL2

# Database Connection (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_laundry_marketplace
DB_USERNAME=root
DB_PASSWORD=

# Google OAuth 2.0 (Untuk Single Sign-On Customer & Kurir)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/RPL2/auth/google/callback

# Google Maps / Leaflet API (Geocoding & Tracking Kurir)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway (Midtrans Core API - Dynamic QRIS)
# Pilihan PAYMENT_GATEWAY: 'simulated' (default sandbox aman) atau 'midtrans'
PAYMENT_GATEWAY=simulated
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# WhatsApp Notification Gateway (Fonnte API)
# Pilihan WHATSAPP_GATEWAY: 'simulated' (default aman) atau 'fonnte'
WHATSAPP_GATEWAY=simulated
FONNTE_TOKEN=your_fonnte_device_token_here
WA_API_URL=https://api.fonnte.com/send
DAILY_SUMMARY_HOUR=21 # Jam pengiriman rekap harian (WIB)

# Keamanan Pengujian WhatsApp Non-Produksi
# Saat APP_ENV != 'production', nomor ini digunakan untuk simulasi pengujian aman
WHATSAPP_ALLOWED_NUMBERS=6281234567890
FONNTE_TEST_PHONE=6281234567890

# Email Gateway (SMTP / Simulated)
MAIL_DRIVER=simulated
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@smartlaundry.id
MAIL_FROM_NAME="SmartLaundry Pro"

# AI Chatbot Assistant Configuration (Multi-Agent Architecture)
# Pilihan AI_PROVIDER: 'mock' (offline rule-based) | 'groq' | 'gemini' | 'openai'
# Jika API Key kosong atau koneksi internet terputus, sistem otomatis fallback ke mode cerdas NLU offline
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=llama-3.3-70b-versatile # Contoh: llama-3.3-70b-versatile (Groq) atau gemini-1.5-flash (Gemini)
AI_BASE_URL=
